<footer class="site-footer">
  <div class="page-width footer-main">
    <div class="footer-message">
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2>{{ section.settings.heading | escape | newline_to_br }}</h2>
      {% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
      {% if section.settings.contact_link != blank %}<a class="text-link" href="{{ section.settings.contact_link }}">{{ section.settings.contact_label | escape }} <span aria-hidden="true">{% render 'icon-arrow' %}</span></a>{% endif %}
    </div>
    {% if section.settings.menu != blank %}
      <nav class="footer-links" aria-label="{{ 'accessibility.footer_navigation' | t }}">
        {% for link in section.settings.menu.links %}<a href="{{ link.url }}">{{ link.title | escape }}</a>{% endfor %}
      </nav>
    {% endif %}
    {% if section.settings.show_artwork %}
      <div class="footer-goose" aria-hidden="true">
        {% if section.settings.artwork != blank %}{{ section.settings.artwork | image_url: width: 700 | image_tag: widths: '350, 700', sizes: '300px', alt: '', loading: 'lazy' }}{% else %}{% render 'brand-artwork', variant: 'goose' %}{% endif %}
      </div>
    {% endif %}
  </div>
  <div class="page-width footer-bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.brand_name | escape }}</p>
    {% if section.settings.show_policies %}<ul class="footer-policies" role="list">{% for policy in shop.policies %}{% if policy.body != blank %}<li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>{% endif %}{% endfor %}</ul>{% endif %}
    {% if section.settings.closing_note != blank %}<p>{{ section.settings.closing_note | escape }}</p>{% endif %}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Goose in Shoes"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Make yourself\nat home."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Short closing copy"
    },
    {
      "type": "text",
      "id": "brand_name",
      "label": "Copyright name",
      "default": "Goose in Shoes"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer menu"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Contact link"
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact link label",
      "default": "Say hello"
    },
    {
      "type": "checkbox",
      "id": "show_artwork",
      "label": "Show supplied goose artwork",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "artwork",
      "label": "Goose artwork override"
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show published Shopify policies",
      "default": true
    },
    {
      "type": "text",
      "id": "closing_note",
      "label": "Closing note",
      "default": "A good place to land."
    }
  ],
  "enabled_on": {
    "groups": [
      "footer"
    ]
  }
}
{% endschema %}
