<div class="craft-section section-space tone-{{ section.settings.tone }}" id="our-story">
  <div class="page-width craft-layout">
    <div class="craft-images" data-reveal>
      <figure class="media-frame craft-images__main">
        {% render 'editorial-media', image: section.settings.image, kind: 'detail', sizes: '(min-width: 900px) 40vw, 80vw' %}
        {% if section.settings.image == blank %}<figcaption class="media-caption">{{ section.settings.placeholder_label | escape }}</figcaption>{% endif %}
      </figure>
      <figure class="media-frame craft-images__detail">
        {% render 'editorial-media', image: section.settings.detail_image, kind: 'detail', sizes: '(min-width: 900px) 22vw, 45vw' %}
      </figure>
    </div>
    <div class="craft-copy" data-reveal>
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2>{{ section.settings.heading | escape | newline_to_br }}</h2>
      {% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
      <div class="craft-notes">
        {% for block in section.blocks %}
          <div class="craft-note" {{ block.shopify_attributes }}>
            <span class="index-label" aria-hidden="true">0{{ forloop.index }}</span>
            <div><h3>{{ block.settings.heading | escape }}</h3>{% if block.settings.text != blank %}<div class="rte">{{ block.settings.text }}</div>{% endif %}</div>
          </div>
        {% endfor %}
      </div>
      {% if section.settings.link != blank and section.settings.link_label != blank %}<a class="text-link" href="{{ section.settings.link }}">{{ section.settings.link_label | escape }} <span aria-hidden="true">{% render 'icon-arrow' %}</span></a>{% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Craftsmanship",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Up close"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "It’s all in\nthe details."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Introduction",
      "default": "<p>Materials. Construction. The little things worth a closer look.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main close-up photograph"
    },
    {
      "type": "image_picker",
      "id": "detail_image",
      "label": "Second detail photograph"
    },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Placeholder caption",
      "default": "Close-up photograph to come"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Story page link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Story link label",
      "default": "Our story"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Background",
      "options": [
        {
          "value": "cream",
          "label": "Warm cream"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "sage",
          "label": "Soft olive"
        },
        {
          "value": "blue",
          "label": "Pale blue"
        }
      ],
      "default": "cream"
    }
  ],
  "max_blocks": 3,
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "blocks": [
    {
      "type": "detail",
      "name": "Craft detail",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Materials"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Verified materials or construction details"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Craftsmanship",
      "blocks": [
        {
          "type": "detail",
          "settings": {
            "heading": "Materials"
          }
        },
        {
          "type": "detail",
          "settings": {
            "heading": "Construction"
          }
        }
      ]
    }
  ],
  "limit": 1
}
{% endschema %}
