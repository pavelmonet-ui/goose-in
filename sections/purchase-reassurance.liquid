<div class="reassurance page-width section-space" data-reveal>
  <div class="reassurance-heading">
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2>{{ section.settings.heading | escape }}</h2>
  </div>
  <div class="reassurance-items">
    {% for block in section.blocks %}
      <details class="reassurance-item" {{ block.shopify_attributes }}>
        <summary>{{ block.settings.heading | escape }}<span class="disclosure-icon" aria-hidden="true"></span></summary>
        <div class="reassurance-answer rte">
          {% if block.settings.text != blank %}{{ block.settings.text }}{% endif %}
          {% if block.settings.page != blank %}{{ block.settings.page.content }}{% endif %}
          {% if block.settings.link != blank %}<a class="text-link" href="{{ block.settings.link }}">{{ block.settings.link_label | escape }} <span aria-hidden="true">{% render 'icon-arrow' %}</span></a>{% endif %}
          {% if block.settings.text == blank and block.settings.page == blank and block.settings.link == blank %}<p>{{ section.settings.empty_text | escape }}</p>{% endif %}
        </div>
      </details>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "The useful details",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Before you settle in"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The useful details."
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Placeholder answer",
      "default": "Details will be added before launch."
    }
  ],
  "max_blocks": 4,
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "blocks": [
    {
      "type": "answer",
      "name": "Purchase detail",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Sizing"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Answer (use confirmed information)"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Page content (optional)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "More information link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Read more"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "The useful details",
      "blocks": [
        {
          "type": "answer",
          "settings": {
            "heading": "Sizing"
          }
        },
        {
          "type": "answer",
          "settings": {
            "heading": "Care"
          }
        },
        {
          "type": "answer",
          "settings": {
            "heading": "Delivery"
          }
        },
        {
          "type": "answer",
          "settings": {
            "heading": "Returns"
          }
        }
      ]
    }
  ],
  "limit": 1
}
{% endschema %}
