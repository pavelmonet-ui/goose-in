{% if section.settings.text != blank %}
  <div class="announcement">
    {% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{% endif %}
      {{ section.settings.text | escape }}
    {% if section.settings.link != blank %}</a>{% endif %}
  </div>
{% endif %}

{% schema %}
{
  "name": "Announcement",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Announcement",
      "default": "A little out of the ordinary. A little closer to home."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "enabled_on": {
    "groups": [
      "header"
    ]
  }
}
{% endschema %}
