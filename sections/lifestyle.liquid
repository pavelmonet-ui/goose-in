<div class="lifestyle-section section-space page-width">
  <div class="lifestyle-heading" data-reveal>
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2>{{ section.settings.heading | escape | newline_to_br }}</h2>
  </div>
  <div class="lifestyle-layout">
    <figure class="media-frame lifestyle-image" data-reveal>
      {% render 'editorial-media', image: section.settings.image, kind: 'lifestyle', sizes: '(min-width: 900px) 65vw, 100vw' %}
      {% if section.settings.image == blank %}<figcaption class="media-caption">{{ section.settings.placeholder_label | escape }}</figcaption>{% endif %}
    </figure>
    <div class="lifestyle-copy" data-reveal>
      {% for block in section.blocks %}
        <div class="moment" {{ block.shopify_attributes }}>
          <span class="index-label">{{ block.settings.eyebrow | escape }}</span>
          <h3>{{ block.settings.heading | escape }}</h3>
          {% if block.settings.text != blank %}<div class="rte">{{ block.settings.text }}</div>{% endif %}
        </div>
      {% endfor %}
      {% if section.settings.link_label != blank %}<a class="text-link" href="{% if section.settings.link != blank %}{{ section.settings.link }}{% else %}#the-collection{% endif %}">{{ section.settings.link_label | escape }} <span aria-hidden="true">{% render 'icon-arrow' %}</span></a>{% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "The moments in between",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "At home, in your own time"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Made for the moments\nin between."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lifestyle photograph"
    },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Placeholder caption",
      "default": "A quiet moment — photograph to come"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Find your pair"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (defaults to products)"
    }
  ],
  "max_blocks": 3,
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "blocks": [
    {
      "type": "moment",
      "name": "Everyday moment",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Small label",
          "default": "01 / A slow start"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Before the day begins."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Short copy"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "The moments in between",
      "blocks": [
        {
          "type": "moment",
          "settings": {
            "eyebrow": "01 / A slow start",
            "heading": "Before the day begins.",
            "text": "<p>The first cup. A quiet room. A moment that’s only yours.</p>"
          }
        },
        {
          "type": "moment",
          "settings": {
            "eyebrow": "02 / Back to yourself",
            "heading": "Nowhere else to be.",
            "text": "<p>Shoes off. The day, gently put down.</p>"
          }
        }
      ]
    }
  ],
  "limit": 1
}
{% endschema %}
