<div class="hero page-width tone-{{ section.settings.tone }}">
  <div class="hero__copy">
    {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h1 class="hero__title">
      <span class="visually-hidden">{{ section.settings.heading | escape }}</span>
      {% if section.settings.slogan != blank %}
        {{ section.settings.slogan | image_url: width: 1200 | image_tag: widths: '400, 800, 1200', sizes: '(min-width: 900px) 40vw, 85vw', alt: '', class: 'hero__custom-slogan' }}
      {% else %}
        {% render 'brand-artwork', variant: 'slogan' %}
      {% endif %}
    </h1>
    {% if section.settings.text != blank %}<div class="hero__intro rte">{{ section.settings.text }}</div>{% endif %}
    {% if section.settings.button_label != blank %}
      <a class="text-link" href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% else %}#the-collection{% endif %}">{{ section.settings.button_label | escape }} <span aria-hidden="true">{% render 'icon-arrow' %}</span></a>
    {% endif %}
  </div>
  <div class="hero__visual media-frame">
    {% assign hero_image = section.settings.image | default: section.settings.mobile_image %}
    {% if hero_image != blank %}
      <picture class="hero__picture">
        {% if section.settings.mobile_image != blank %}
          <source media="(max-width: 899px)" sizes="100vw" srcset="{{ section.settings.mobile_image | image_url: width: 540 }} 540w, {{ section.settings.mobile_image | image_url: width: 750 }} 750w, {{ section.settings.mobile_image | image_url: width: 1000 }} 1000w">
        {% endif %}
        {% render 'editorial-media', image: hero_image, kind: 'product', eager: true, sizes: '(min-width: 900px) 60vw, 100vw' %}
      </picture>
    {% else %}
      {% render 'editorial-media', kind: 'product' %}
      {% if section.settings.placeholder_label != blank %}<span class="media-caption hero__placeholder-label">{{ section.settings.placeholder_label | escape }}</span>{% endif %}
    {% endif %}
    {% if section.settings.caption != blank %}<span class="hero__caption">{{ section.settings.caption | escape }}</span>{% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Editorial hero",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Slippers, with a little personality."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Accessible heading",
      "default": "Made for the moments in between."
    },
    {
      "type": "image_picker",
      "id": "slogan",
      "label": "Handwritten slogan override"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Short introduction",
      "default": "<p>Meet your new favourite reason to stay in.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Discover the four models"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link (defaults to products)"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero photograph"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile photograph (optional)"
    },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Placeholder caption",
      "default": "Product photograph to come"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Image note",
      "default": "A quieter kind of everyday."
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Background",
      "options": [
        {
          "value": "cream",
          "label": "Warm cream"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "sage",
          "label": "Soft olive"
        },
        {
          "value": "blue",
          "label": "Pale blue"
        }
      ],
      "default": "cream"
    }
  ],
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "presets": [
    {
      "name": "Editorial hero"
    }
  ],
  "limit": 1
}
{% endschema %}
