<div class="gift-section tone-{{ section.settings.tone }}">
  <div class="page-width gift-layout section-space">
    <div class="gift-copy" data-reveal>
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2>{{ section.settings.heading | escape | newline_to_br }}</h2>
      {% if section.settings.text != blank %}<div class="rte">{{ section.settings.text }}</div>{% endif %}
      <ul class="gift-recipients" role="list">
        {% for block in section.blocks %}<li {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</li>{% endfor %}
      </ul>
      {% if section.settings.link_label != blank %}<a class="text-link" href="{% if section.settings.link != blank %}{{ section.settings.link }}{% else %}#the-collection{% endif %}">{{ section.settings.link_label | escape }} <span aria-hidden="true">{% render 'icon-arrow' %}</span></a>{% endif %}
    </div>
    <figure class="media-frame gift-image" data-reveal>
      {% render 'editorial-media', image: section.settings.image, kind: 'gift', sizes: '(min-width: 900px) 45vw, 100vw' %}
      {% if section.settings.image == blank %}<figcaption class="media-caption">{{ section.settings.placeholder_label | escape }}</figcaption>{% endif %}
    </figure>
  </div>
</div>

{% schema %}
{
  "name": "A thoughtful gift",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A little thought goes a long way"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "For someone\nyou love."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Short copy",
      "default": "<p>A thoughtful pair, for their everyday.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Gift photograph"
    },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Placeholder caption",
      "default": "Gift photograph to come"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Choose a pair"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link (defaults to products)"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Background",
      "options": [
        {
          "value": "cream",
          "label": "Warm cream"
        },
        {
          "value": "sand",
          "label": "Sand"
        },
        {
          "value": "sage",
          "label": "Soft olive"
        },
        {
          "value": "blue",
          "label": "Pale blue"
        }
      ],
      "default": "cream"
    }
  ],
  "max_blocks": 5,
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "blocks": [
    {
      "type": "recipient",
      "name": "Recipient",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Recipient",
          "default": "For your mum"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "A thoughtful gift",
      "blocks": [
        {
          "type": "recipient",
          "settings": {
            "text": "For your mum"
          }
        },
        {
          "type": "recipient",
          "settings": {
            "text": "For your sister"
          }
        },
        {
          "type": "recipient",
          "settings": {
            "text": "For your partner"
          }
        },
        {
          "type": "recipient",
          "settings": {
            "text": "For someone you love"
          }
        },
        {
          "type": "recipient",
          "settings": {
            "text": "Or just for yourself."
          }
        }
      ]
    }
  ],
  "limit": 1
}
{% endschema %}
