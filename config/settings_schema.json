[
  {
    "name": "theme_info",
    "theme_name": "Goose in Shoes",
    "theme_version": "1.0.0",
    "theme_author": "Goose in Shoes",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#F8F3EA",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#243A3A",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "Editorial style",
    "settings": [
      {
        "type": "color",
        "id": "accent_color",
        "label": "Ink blue",
        "default": "#075D7A"
      },
      {
        "type": "color",
        "id": "sand_color",
        "label": "Sand",
        "default": "#E9E1D4"
      },
      {
        "type": "color",
        "id": "sage_color",
        "label": "Soft olive",
        "default": "#E0E1D3"
      },
      {
        "type": "color",
        "id": "blue_color",
        "label": "Pale blue",
        "default": "#E1E9E9"
      },
      {
        "type": "color",
        "id": "rose_color",
        "label": "Dusty rose",
        "default": "#EEDFD7"
      },
      {
        "type": "font_picker",
        "id": "heading_font",
        "label": "Editorial heading font",
        "default": "baskerville_n4"
      },
      {
        "type": "checkbox",
        "id": "enable_reveals",
        "label": "Enable subtle scroll reveals",
